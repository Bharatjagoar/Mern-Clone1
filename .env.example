# App
NODE_ENV=development
PORT=3000

# Postgres (used by API/worker containers)
DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/taskflow?schema=public
# Used by docker-compose to provision the postgres container itself
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Auth rate limit
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Email
EMAIL_RATE_LIMIT_MAX=50
EMAIL_RATE_LIMIT_WINDOW_MS=60000
